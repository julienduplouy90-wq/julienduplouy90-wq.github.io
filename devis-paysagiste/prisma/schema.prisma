// Schéma de la base (PostgreSQL via Prisma).
// SaaS : simulateur d'estimation intégrable pour paysagistes.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Une entreprise de paysage cliente du SaaS.
// Le slug sert d'identifiant public (simulateur + lien dashboard).
model Entreprise {
  id         Int    @id @default(autoincrement())
  slug       String @unique
  nom        String
  telephone  String?
  email      String?
  ville      String?
  codePostal String?
  zone       String? // zone d'intervention affichée aux particuliers

  // Personnalisation white-label du simulateur
  couleur String  @default("#166534") // couleur principale (hex)
  logo    String? // logo en data-URL (petite image), optionnel

  // Seuils de qualification des leads (sur l'estimation haute, en €)
  seuilPetit Int @default(2000)  // en dessous : PETIT PROJET
  seuilFort  Int @default(10000) // au dessus : PROJET À FORTE VALEUR

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  prestations EntreprisePrestation[]
  simulations Simulation[]
  leads       Lead[]
}

// Un type de projet activé par l'entreprise, avec SES règles tarifaires.
// Les règles sont du JSON : { base: {min,max}, coefficients: {question: {option: coef}} }
// — structure souple pour ajouter des variables sans migration.
model EntreprisePrestation {
  id           Int        @id @default(autoincrement())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId Int
  typeProjet   String // id du catalogue : "terrasse", "cloture", …
  active       Boolean    @default(true)
  regles       Json

  @@unique([entrepriseId, typeProjet])
}

// Une simulation faite par un particulier sur le simulateur public.
// Devient un lead si le particulier laisse ses coordonnées.
model Simulation {
  id           Int        @id @default(autoincrement())
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId Int
  typeProjet   String
  reponses     Json // { questionId: valeur } tel que saisi
  photos       Json // tableau de data-URLs (images compressées côté client)

  // Fourchette calculée côté serveur au moment de la simulation
  estimationMin Float?
  estimationMax Float?

  creeLe DateTime @default(now())
  lead   Lead?
}

// Coordonnées laissées à la fin d'une simulation : le prospect qualifié.
model Lead {
  id           Int        @id @default(autoincrement())
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationId Int        @unique
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId Int

  prenom     String
  nom        String
  email      String
  telephone  String
  codePostal String
  commune    String?
  delai      String // "des-que-possible" | "1-3-mois" | "3-6-mois" | "plus-tard"
  budgetMax  Float? // budget maximum envisagé par le client (optionnel)

  creeLe DateTime @default(now())
}
