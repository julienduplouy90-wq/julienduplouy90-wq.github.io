# ─── Base de données ─────────────────────────────────────────────
# local  : PostgreSQL embarqué (PGlite) persistant dans ./.data/pglite (défaut, aucun service requis)
# memory : PGlite en mémoire (tests)
# postgres : connexion PostgreSQL / Supabase via DATABASE_URL
DATABASE_MODE=local
# Dossier de la base locale (défaut : ./.data/pglite en dev, ~/leadfactory-data/pglite en production)
# PGLITE_DIR=
# DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.[PROJET].supabase.co:5432/postgres

# Données de démonstration fictives au premier démarrage (true uniquement pour tester)
SEED_DEMO=false

# ─── Sécurité ────────────────────────────────────────────────────
# Mot de passe de l'espace d'administration (HTTP Basic). Obligatoire en production.
# ADMIN_PASSWORD=
# Sel pour hacher les adresses IP des formulaires (chaîne aléatoire longue en production)
IP_HASH_SALT=change-me-in-production

# ─── Sites publics ───────────────────────────────────────────────
# Correspondance domaine → site (séparateur virgule). Ex. : mon-domaine.fr=assainissement-dordogne
# SITE_DOMAINS=
# URL publique de base utilisée pour le sitemap en prévisualisation locale
PUBLIC_BASE_URL=http://localhost:3000

# ─── Futur (non utilisé dans le MVP) ─────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
